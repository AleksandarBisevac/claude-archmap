{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AleksandarBisevac/claude-archmap/schema/archmap-theme.schema.json",
  "title": "archmap theme",
  "description": "docs/architecture/archmap.theme.json. Fonts, chrome and accent only. Relation, zone and severity colours are fixed and semantic (D10) and are deliberately not themeable.",
  "type": "object",
  "properties": {
    "fonts": {
      "type": "object",
      "properties": {
        "sans": { "type": "string", "minLength": 1 },
        "mono": { "type": "string", "minLength": 1 }
      }
    },
    "chrome": {
      "type": "object",
      "properties": {
        "bg": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "muted": { "type": "string", "minLength": 1 },
        "border": { "type": "string", "minLength": 1 }
      }
    },
    "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
  }
}
